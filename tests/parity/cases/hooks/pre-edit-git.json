  {
    "name": "the main agent entering a worktree it did not start in widens to the session base",
    "fixture": "workspace",
    "git": true,
    "pluginData": true,
    "env": {
      "CLAUDE_PLUGIN_ROOT": "/plugin"
    },
    "setup": [
      {
        "git": [
          "add",
          "-A"
        ]
      },
      {
        "git": [
          "commit",
          "-qm",
          "init"
        ]
      },
      {
        "write": {
          "README.md": "later\n"
        }
      },
      {
        "git": [
          "add",
          "-A"
        ]
      },
      {
        "git": [
          "commit",
          "-qm",
          "later"
        ]
      },
      {
        "git": [
          "worktree",
          "add",
          "-q",
          "--detach",
          ".claude/worktrees/w1"
        ]
      },
      {
        "write": {
          ".git/temper/sessions/s1/base": "HEAD~1\n"
        }
      }
    ],
    "steps": [
      {
        "event": "pre-edit",
        "stdin": "{\"session_id\":\"s1\",\"cwd\":\"<ROOT>/.claude/worktrees/w1\",\"tool_name\":\"Write\",\"tool_input\":{\"file_path\":\"<ROOT>/.claude/worktrees/w1/crates/core/src/lib.rs\",\"content\":\"//! Core.\\n\\n/// Two.\\n#[must_use]\\npub fn two() -> u8 {\\n    2\\n}\\n\"}}"
      }
    ]
  },
