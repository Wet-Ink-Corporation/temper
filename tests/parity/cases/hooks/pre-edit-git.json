[
  {
    "name": "a denied Rust edit by the main agent records its checkout: HEAD, the branch and the start fingerprint",
    "fixture": "workspace",
    "git": true,
    "pluginData": true,
    "env": {
      "CLAUDE_PLUGIN_ROOT": "/plugin"
    },
    "setup": [
      {
        "git": [
          "add",
          "-A"
        ]
      },
      {
        "git": [
          "commit",
          "-qm",
          "init"
        ]
      }
    ],
    "steps": [
      {
        "event": "pre-edit",
        "stdin": "{\"session_id\":\"s1\",\"cwd\":\"<ROOT>\",\"tool_name\":\"Write\",\"tool_input\":{\"file_path\":\"<ROOT>/crates/core/src/lib.rs\",\"content\":\"//! Core.\\n\\n/// Two.\\n#[must_use]\\npub fn two() -> u8 {\\n    2\\n}\\n\"}}"
      }
    ]
  },
