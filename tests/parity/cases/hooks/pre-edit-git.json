  {
    "name": "a second edit by the same agent keeps the first record",
    "fixture": "workspace",
    "git": true,
    "pluginData": true,
    "env": {
      "CLAUDE_PLUGIN_ROOT": "/plugin"
    },
    "setup": [
      {
        "git": [
          "add",
          "-A"
        ]
      },
      {
        "git": [
          "commit",
          "-qm",
          "init"
        ]
      }
    ],
    "steps": [
      {
        "event": "pre-edit",
        "stdin": "{\"session_id\":\"s1\",\"cwd\":\"<ROOT>\",\"tool_name\":\"Write\",\"tool_input\":{\"file_path\":\"<ROOT>/crates/core/src/lib.rs\",\"content\":\"//! Core.\\n\\n/// Two.\\n#[must_use]\\npub fn two() -> u8 {\\n    2\\n}\\n\"}}"
      },
      {
        "event": "pre-edit",
        "stdin": "{\"session_id\":\"s1\",\"cwd\":\"<ROOT>\",\"tool_name\":\"Write\",\"tool_input\":{\"file_path\":\"<ROOT>/crates/core/src/lib.rs\",\"content\":\"//! Again.\\n\"}}",
        "before": [
          {
            "write": {
              "crates/core/src/lib.rs": "//! Core.\n\n/// Two.\n#[must_use]\npub fn two() -> u8 {\n    2\n}\n"
            }
          }
        ]
      }
    ]
  },
  {
