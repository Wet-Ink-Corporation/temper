        "stdin": "{\"session_id\":\"s1\",\"cwd\":\"<ROOT>\",\"agent_id\":\"im1\",\"agent_type\":\"temper:rust-implementer\",\"tool_name\":\"Write\",\"tool_input\":{\"file_path\":\"<ROOT>/crates/core/src/lib.rs\",\"content\":\"//! Core.\\n\\n/// Two.\\n#[must_use]\\npub fn two() -> u8 {\\n    2\\n}\\n\"}}"
