      {
        "git": [
          "commit",
          "-qm",
          "init"
        ]
      }
    ],
    "event": "session-start",
    "stdin": "{\"session_id\":\"s1\",\"cwd\":\"<ROOT>\",\"source\":\"startup\"}"
  },
