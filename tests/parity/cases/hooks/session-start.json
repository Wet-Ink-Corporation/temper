          "add",
          "-A"
        ]
      },
      {
        "git": [
          "commit",
          "-qm",
          "init"
        ]
      },
      {
        "write": {
          ".git/temper/telemetry.jsonl": "{\"t\":\"<ISO:-60000>\",\"sid\":\"s1\",\"agent\":\"main\",\"event\":\"gate-start\",\"pid\":<DEADPID>,\"timeoutMs\":1200000}\n{\"t\":\"<ISO:-60000>\",\"sid\":\"s1\",\"agent\":\"temper:rust-implementer\",\"event\":\"gate-start\",\"agent_id\":\"im1\",\"pid\":2147483645,\"timeoutMs\":1200000}\n{\"t\":\"<ISO:-60000>\",\"sid\":\"s1\",\"agent\":\"temper:rust-reviewer\",\"event\":\"gate-start\",\"agent_id\":\"rv1\",\"pid\":<PID>,\"timeoutMs\":1200000}\n{\"t\":\"<ISO:-60000>\",\"sid\":\"other\",\"agent\":\"main\",\"event\":\"gate-start\",\"pid\":2147483644,\"timeoutMs\":1200000}\n{\"t\":\"<ISO:-60000>\",\"sid\":\"s1\",\"agent\":\"main\",\"event\":\"gate-start\",\"pid\":2147483643,\"timeoutMs\":1200000}\n{\"t\":\"<ISO:-60000>\",\"sid\":\"s1\",\"agent\":\"main\",\"event\":\"stop-green\",\"pid\":2147483643}\n",
          ".git/temper/gate-progress-00000000000000aa.json": "{\"fp\":\"00000000000000aa\",\"pid\":<DEADPID>,\"startedAt\":\"<ISO:-60000>\",\"steps\":[{\"name\":\"fmt\",\"ok\":true,\"ms\":800}],\"current\":{\"name\":\"test\",\"startedAt\":\"<ISO:-40000>\"}}",
          ".git/temper/sessions/s1/gate-alive-agent-im1.json": "{\"pid\":2147483645,\"at\":<MS:-15000>}"
        }
      },
      {
        "age": {
