  {
    "name": "startup in a committed tree records the base, start time and fingerprint, and says no changes",
    "fixture": "workspace",
    "git": true,
    "pluginData": true,
    "env": {
      "CLAUDE_PLUGIN_ROOT": "/plugin"
    },
    "setup": [
      {
        "git": [
          "add",
          "-A"
        ]
